# =====================================
# CargoCamp Git Ignore
# =====================================

# Dependencies
**/node_modules/

# Build artifacts
**/build/
**/dist/
**/coverage/

# Tests
**/test-results/
**/playwright-report/

# Local IDE
**/.idea/
**/.vscode/
*.iml

# Environment and secrets
.env
.env.*
!.env.example

# Sensitive files
**/*.jks
**/*.keystore
**/*.p12
**/*.pfx

# Backend private data
backend/secrets/
backend/uploads/
backend/contracts/
backend/private-documents/

# Local database exports
Database/
*.sql.gz
*.sql.zip
*.dump

# Android local files
frontend/android/local.properties
frontend/android/app/google-services.json

# iOS generated files
**/Pods/
**/DerivedData/
**/*.xcuserstate
**/xcuserdata/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db