{
  "name": "cargocamp",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "npm run test:all",
    "test:backend": "npm --prefix backend test",
    "test:mysql:prepare": "docker compose -p cargocamp-final-tests -f backend/tests/integration/compose.mysql.yml up -d --wait",
    "test:mysql": "npm run test:mysql:prepare && npm --prefix backend run test:integration:mysql",
    "test:frontend": "npm --prefix frontend run test:e2e",
    "test:admin": "npm --prefix admin-panel run test:e2e",
    "test:all": "npm run test:backend && npm run test:mysql && npm run test:frontend && npm run test:admin"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/KatrideRRR/CargoCamp.git"
  },
  "private": true,
  "dependencies": {
    "@playwright/test": "^1.56.1",
    "browser-image-compression": "^2.0.2",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.72.0",
    "react-datepicker": "^9.1.0",
    "react-router-dom": "^7.9.6",
    "supertest": "^7.1.4"
  }
}
